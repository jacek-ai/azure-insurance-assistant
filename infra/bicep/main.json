            "name": "FUNCTION_X_FUNCTIONS_KEY",
            "secureValue": "[parameters('functionXFunctionsKey')]"
          }
        ],
        "scriptContent": "set -euo pipefail\r\n\r\necho \"Setting Function App host key 'default'...\"\r\naz functionapp keys set \\\r\n  -g \"$RESOURCE_GROUP\" \\\r\n  -n \"$FUNCTION_APP_NAME\" \\\r\n  --key-type functionKeys \\\r\n  --key-name default \\\r\n  --key-value \"$FUNCTION_X_FUNCTIONS_KEY\" \\\r\n  -o none\r\necho \"Done.\"\r\n"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'functionApp')]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-keysetter', variables('functionAppName')))]",
        "[resourceId('Microsoft.Resources/deployments', 'rbac')]"
      ]
    },
