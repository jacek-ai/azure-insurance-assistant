# Azure AI Search Configuration
SEARCH_SERVICE_ENDPOINT=https://YOUR-SEARCH-RESOURCE.search.windows.net
SEARCH_API_VERSION=2025-11-01-preview
SEARCH_USE_AAD=true
SEARCH_KNOWLEDGESOURCE_NAME=knowledgesource
# Delimiter to separate product ID parts in filenames (e.g., delimiter "__" for "product01__12345.pdf" -> product ID "product01")
SEARCH_PRODUCT_ID_DELIMITER=__

#AI Foundry Configuration
AI_SERVICE_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.openai.azure.com
AI_MODEL_DEPLOYMENT=text-embedding-3-small
AI_MODEL_NAME=text-embedding-3-small
AI_AGENT_NAME=insurance-product-agent

# AI Foundry Project (Agent) Configuration
# Used by src/agent/create_agent
AI_SERVICE_PROJECT_ENDPOINT=https://YOUR-FOUNDRY-PROJECT-RESOURCE.services.ai.azure.com/api/projects/YOUR_PROJECT_NAME
FUNCTION_BASE_URL=https://YOUR-FUNCTIONAPP.azurewebsites.net
# Create this Foundry Project Connection as 'Custom keys' with key name 'x-functions-key'
FUNCTION_PROJECT_CONNECTION_NAME=con-function-insurance-assistance

# Infrastructure note:
# If you want Bicep to create the Foundry Project connection automatically, store the Functions host key
# (Function App -> App keys -> default) in Key Vault and reference it from infra/bicep/main.bicepparam.

# Azure Storage Configuration
STORAGE_CONNECTION_STRING=ResourceId={YOUR_STORAGE_RESOURCE_ID};
STORAGE_CONTAINER_NAME=rag-data

# -----------------------------------------------------------------------------
# Optional script configuration (PowerShell scripts in ./scripts)
# -----------------------------------------------------------------------------
# If set, scripts will use these values instead of their built-in defaults.
RESOURCE_GROUP_NAME=rg-dev-insurance-assistant
AZURE_LOCATION=swedencentral
FUNCTION_APP_NAME=insast-dev-swedencen-fapp-0001
STORAGE_ACCOUNT_NAME=insastdevswedencen0001
KEYVAULT_NAME=insastdevswedencenkv0001

# Used by cleanup.ps1 to filter which soft-deleted Cognitive Services accounts to purge.
RESOURCE_NAME_PREFIX=insast-dev-